import Component from "@glimmer/component";
import { ajax } from "discourse/lib/ajax";
export default class VipSepayMembers extends Component { async cancel(member){await ajax(`/admin/vip-sepay/subscriptions/${member.id}/cancel.json`,{type:"POST"});window.location.reload();} <template><div class="vip-sepay-admin"><h1>Thành viên VIP</h1><table class="vip-sepay-table"><thead><tr><th>Username</th><th>Gói</th><th>Group</th><th>Bắt đầu</th><th>Hết hạn</th><th></th></tr></thead><tbody>{{#each @model.members as |member|}}<tr><td>{{member.username}}</td><td>{{member.plan_name}}</td><td>{{member.group_name}}</td><td>{{member.starts_at}}</td><td>{{member.expires_at}}</td><td><button class="btn btn-danger btn-small" type="button" {{on "click" (fn this.cancel member)}}>Hủy</button></td></tr>{{/each}}</tbody></table></div></template>}
