import Component from "@glimmer/component";
import { ajax } from "discourse/lib/ajax";
export default class VipSepayOrders extends Component { async cancel(order){await ajax(`/admin/vip-sepay/orders/${order.id}/cancel.json`,{type:"POST"});window.location.reload();} <template><div class="vip-sepay-admin"><h1>Đơn hàng</h1><table class="vip-sepay-table"><thead><tr><th>Mã</th><th>Thành viên</th><th>Gói</th><th>Số tiền</th><th>Trạng thái</th><th></th></tr></thead><tbody>{{#each @model.orders as |order|}}<tr><td><code>{{order.order_code}}</code></td><td>{{order.username}}</td><td>{{order.plan_name}}</td><td>{{order.amount_vnd}} ₫</td><td>{{order.status}}</td><td>{{#if (eq order.status "pending")}}<button class="btn btn-danger btn-small" type="button" {{on "click" (fn this.cancel order)}}>Hủy</button>{{/if}}</td></tr>{{/each}}</tbody></table></div></template>}
