import Component from "@glimmer/component";
export default class VipSepayTransactions extends Component { <template><div class="vip-sepay-admin"><h1>Giao dịch SePay</h1><table class="vip-sepay-table"><thead><tr><th>SePay ID</th><th>Mã đơn</th><th>Số tiền</th><th>Gateway</th><th>Trạng thái</th><th>Thời gian</th></tr></thead><tbody>{{#each @model.transactions as |tx|}}<tr><td>{{tx.sepay_transaction_id}}</td><td><code>{{tx.order_code}}</code></td><td>{{tx.amount_vnd}} ₫</td><td>{{tx.gateway}}</td><td>{{tx.status}}</td><td>{{tx.transaction_at}}</td></tr>{{/each}}</tbody></table></div></template>}
